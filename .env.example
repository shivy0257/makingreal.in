# Public contact channels shown on the site. Copy to .env and fill in real values.
# WhatsApp number in international format without "+" (used for wa.me links and the displayed phone).
VITE_WHATSAPP_NUMBER=
# Public enquiry email (mailto link shown in the contact section and footer).
VITE_CONTACT_EMAIL=

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (optional, analytics tags stay off without it).
VITE_GA_ID=
# Microsoft Clarity Project ID, e.g. abcdefgh (optional).
VITE_CLARITY_ID=
# Web3Forms access key (optional; without it the brief form shows WhatsApp/email fallback).
VITE_WEB3FORMS_KEY=
